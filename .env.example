# Supabase
NEXT_PUBLIC_SUPABASE_URL=              # Supabase project URL — Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon/public key — Settings > API
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY — Settings > API, used for cron/retention job + ai_usage_log writes; never expose to client

# OpenAI
OPENAI_API_KEY=                        # SERVER ONLY — platform.openai.com/api-keys — used exclusively in app/api/* route handlers for extraction + chat

# App
NEXT_PUBLIC_APP_URL=                   # e.g. http://localhost:3000 in dev, production URL when deployed — used for signed-URL/auth redirect construction

# Security
MAX_CHAT_HISTORY=20                    # Ceiling on turns sent for 'history'-classified chat questions — see lib/security/tokenLimiter.ts
